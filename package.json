{
  "name": "fishblog",
  "version": "1.0.0",
  "description": "A minimal blog running on Cloudflare Workers + D1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.mjs",
    "db:init": "wrangler d1 execute fishblog-db --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute fishblog-db --remote --file=src/db/schema.sql",
    "setup": "bash setup.sh"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "marked": "^17.0.5",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261102.0-beta",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.2"
  }
}
